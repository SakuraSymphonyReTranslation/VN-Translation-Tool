    {
        "id": 38,
        "original": "ひより",
        "translations": {
            "initial": "Hiyori",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 39,
        "original": "「@t79@d1我らＳＳＲの『みんなを笑顔にする』という理念を、未羽にもご理解いただけたなら……ここは是非、もう一働きしてもらいたいね！」",
        "translations": {
            "initial": "「@t79@d1Kalau Miu sudah memahami filosofi SSR kita untuk 'membuat semua orang tersenyum'...... maka sekarang, aku ingin kamu bekerja sekali lagi！」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 40,
        "original": "未羽",
        "translations": {
            "initial": "Miu",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 41,
        "original": "「えっ！？」",
        "translations": {
            "initial": "「Eh！？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 42,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 43,
        "original": "「何かあるのか――」",
        "translations": {
            "initial": "「Ada apa memangnya-」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 44,
        "original": "と聞きかけて気がついた。",
        "translations": {
            "initial": "Aku baru menyadarinya tepat saat akan bertanya.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 45,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 46,
        "original": "「白河、もしかして昨日言ってた……」",
        "translations": {
            "initial": "「Shirakawa, jangan-jangan yang kamu bilang kemarin itu......」",
            "machine": "",
            "better": "",
