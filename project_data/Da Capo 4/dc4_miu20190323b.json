        "id": 47,
        "original": "ひより",
        "translations": {
            "initial": "Hiyori",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 48,
        "original": "「@t16@d1大正解！ボクたちもう一度、未羽のバイト姿が見たいなぁ～」",
        "translations": {
            "initial": "「@t16@d1Tepat sekali！ Kami ingin melihat Miu saat sedang bekerja lagi, lho~」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
