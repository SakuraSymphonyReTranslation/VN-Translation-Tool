    {
        "id": 51,
        "original": "ひより",
        "translations": {
            "initial": "Hiyori",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 52,
        "original": "「@t36@d1当たり前だよ。昨日フラグを立てたでしょ？立てたフラグはきちんと消化しないとね」",
        "translations": {
            "initial": "「@t36@d1Wajar saja, kan? Bukannya kemarin kamu sudah kasih kode? Kode yang sudah dibuat itu harus dituntaskan sampai akhir」",
            "machine": "",
            "better": "",
            "best": "",
