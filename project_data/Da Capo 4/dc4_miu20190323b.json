            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 63,
        "original": "「ええええええええっ！？」",
        "translations": {
            "initial": "「Eeeeeeeeeeeh！？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 64,
        "original": "慌てた美嶋さんが梓さんに目を向けると、笑顔で手を振って返してきた。",
        "translations": {
