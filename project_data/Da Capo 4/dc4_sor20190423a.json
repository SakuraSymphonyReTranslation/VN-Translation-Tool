        "original": "諳子",
        "translations": {
            "initial": "Sorane",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 105,
        "original": "@t30@d1@t70@d2「そう、だね……うん、わたしもそのつもりだった。でも、いっちゃんが教えてくれたの。自分に嘘をつき続けることはできないって」",
        "translations": {
            "initial": "@t30@d1@t70@d2「Begitu, ya...... Iya, awalnya aku juga berniat begitu. Tapi, Icchan menyadarkanku kalau aku nggak bisa terus-terusan membohongi diri sendiri」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
