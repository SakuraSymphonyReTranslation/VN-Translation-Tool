        "id": 106,
        "original": "諳子",
        "translations": {
            "initial": "Sorane",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 107,
        "original": "「だから、わたしは自分の気持ちに正直になることに決めた。いっちゃんのことが好き、って気持ちに」",
        "translations": {
