            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 111,
        "original": "「どう、かな？」",
        "translations": {
            "initial": "「Gimana, menurutmu？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 112,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 113,
        "original": "@t25@d1「おめでとうございます、そら姉。しあわせになってくださいね」",
