[
    {
        "id": 0,
        "original": "声",
        "translations": {
            "initial": "Suara",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 1,
        "original": "「いっちゃん、朝だよー。起きてー」",
        "translations": {
            "initial": "「Icchan, sudah pagi. Ayo bangun-」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 2,
        "original": "やわらかい声が、俺の鼓膜をやさしく刺激する。",
        "translations": {
            "initial": "Suara lembut itu menggelitik gendang telingaku dengan pelan.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 3,
        "original": "この声は……そら姉？",
        "translations": {
            "initial": "Suara ini... Sora-nee？",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 4,
        "original": "ごめん、なんだか……眠くて……。",
        "translations": {
            "initial": "Maaf, entah kenapa... aku masih mengantuk....",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 5,
        "original": "諳子",
        "translations": {
            "initial": "Sorane",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 6,
        "original": "「仕方ないなー。なかなか起きない人には、こうなんだから」",
        "translations": {
            "initial": "「Yah, apa boleh buat. Buat orang yang nggak mau bangun-bangun, harus diginiin ya」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 7,
        "original": "ぎしっとベッドのきしむ音と、近付いてくる気配。",
        "translations": {
            "initial": "Terdengar derit tempat tidur dan hawa seseorang yang mendekat.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 8,
        "original": "もしかして、これは……。",
        "translations": {
            "initial": "Jangan-jangan, ini adalah....",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 9,
        "original": "諳子",
        "translations": {
            "initial": "Sorane",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 10,
        "original": "「起きないと、ほんとうに……しちゃうよ？」",
        "translations": {
            "initial": "「Kalau nggak bangun, beneran bakal... aku lakuin, lho？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 11,
        "original": "耳元でささやかれる声。と甘い匂い。",
        "translations": {
            "initial": "Suara yang berbisik di telinga. Dan aroma yang manis.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 12,
        "original": "起きないとという思いと、この先どうなるのかという淡い期待とが入り混じる。",
        "translations": {
            "initial": "Rasa harus segera bangun bercampur dengan harapan tipis akan apa yang akan terjadi selanjutnya.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 13,
        "original": "諳子",
        "translations": {
            "initial": "Sorane",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 14,
        "original": "「はい、時間切れ」",
        "translations": {
            "initial": "「Oke, waktu habis」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 15,
        "original": "吐息が顔にかかる。",
        "translations": {
            "initial": "Hembusan napas menerpa wajahku.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 16,
        "original": "温かい体温が、徐々に近付いて――。",
        "translations": {
            "initial": "Suhu tubuh yang hangat perlahan semakin mendekat dan-.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 17,
        "original": "――ピピピピ？",
        "translations": {
            "initial": "-Pipipipipi？",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 18,
        "original": "目覚ましの、アラーム？ってことは……。",
        "translations": {
            "initial": "Alarm jam beker？ Berarti ini....",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 19,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 20,
        "original": "「あー……」",
        "translations": {
            "initial": "「Ah-...」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 21,
        "original": "部屋の中には、どこにもそら姉はいなかった。",
        "translations": {
            "initial": "Di dalam kamar, Sora-nee tidak ada di mana pun.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 22,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 23,
        "original": "「あ、あははは……夢か」",
        "translations": {
            "initial": "「A-ahahaha.... Ternyata mimpi ya」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 24,
        "original": "思い返してみれば、さっきのそら姉にはウサ耳が生えていなかった。",
        "translations": {
            "initial": "Kalau diingat-ingat lagi, Sora-nee yang tadi tidak punya telinga kelinci.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 25,
        "original": "あんな夢を見るなんて、我ながら浮かれ過ぎだとは思う。",
        "translations": {
            "initial": "Aku merasa diriku terlalu kegirangan sampai-sampai memimpikan hal seperti itu.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 26,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 27,
        "original": "「けど、仕方ないよな。こんな夢を見てしまうのも。そら姉に告白して、付き合うことになったんだから」",
        "translations": {
            "initial": "「Tapi, ya mau gimana lagi kalau aku sampai bermimpi begitu. Kan aku baru saja menyatakan perasaan dan jadian sama Sora-nee」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 28,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 29,
        "original": "「それに――キスもしたし」",
        "translations": {
            "initial": "「Lagipula-kami juga sudah berciuman」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 30,
        "original": "枕をそら姉に見立てて抱きしめる。",
        "translations": {
            "initial": "Aku memeluk bantal seolah-olah itu adalah Sora-nee.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 31,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 32,
        "original": "「ん？この匂い……」",
        "translations": {
            "initial": "「Hm？ Bau ini...」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 33,
        "original": "おいしそうな匂いが階下から漂ってくる。",
        "translations": {
            "initial": "Aroma lezat tercium dari lantai bawah.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 34,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 35,
        "original": "「ってことは、急げ……！」",
        "translations": {
            "initial": "「Kalau begitu, aku harus cepat...！」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 36,
        "original": "俺は慌てて着替えて、階下に向かった。",
        "translations": {
            "initial": "Aku segera berganti pakaian dan bergegas menuju lantai bawah.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 37,
        "original": "リビングの入口で、俺はその光景を飽きることなく眺めていた。",
        "translations": {
            "initial": "Di pintu masuk ruang tamu, aku menatap pemandangan itu tanpa rasa bosan.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 38,
        "original": "キッチンに立ったそら姉が料理している。",
        "translations": {
            "initial": "Sora-nee sedang memasak di dapur.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 39,
        "original": "見慣れた光景なのに、今日はいつもと何かが違って見えた。",
        "translations": {
            "initial": "Meskipun itu pemandangan yang biasa kulihat, hari ini entah kenapa terasa berbeda.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 40,
        "original": "どうしてか……なんてのは、いちいち言うまでもないだろう。",
        "translations": {
            "initial": "Alasannya... kurasa tidak perlu dijelaskan satu per satu.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 41,
        "original": "諳子",
        "translations": {
            "initial": "Sorane",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 42,
        "original": "@t88@d1「うーん……いっちゃんの好きな味はもう少し甘めで。ん、こんな感じかな？ふふっ、いっちゃん、喜んでくれるかな？」",
        "translations": {
            "initial": "@t88@d1「Umm... rasa kesukaan Icchan harus sedikit lebih manis. Nah, mungkin seperti ini？ Hehe, apa Icchan bakal senang ya？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 43,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 44,
        "original": "「もちろん」",
        "translations": {
            "initial": "「Tentu saja」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 45,
        "original": "もうしばらく黙って見守っていたようと思っていたのに、我慢ができなかった。",
        "translations": {
            "initial": "Tadinya aku berniat memperhatikannya diam-diam lebih lama lagi, tapi aku sudah tidak tahan.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 46,
        "original": "諳子",
        "translations": {
            "initial": "Sorane",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 47,
        "original": "@d1@t10@d2「え、あ、いっちゃん！？」",
        "translations": {
            "initial": "@d1@t10@d2「Eh, ah, Icchan！？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 48,
        "original": "目を大きくして驚くそら姉を見て、意地が悪いと思いつつも笑ってしまった。",
        "translations": {
            "initial": "Melihat Sora-nee yang terkejut dengan mata membelalak, aku tertawa meskipun merasa sedikit jahil.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 49,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 50,
        "original": "「おはよう、そら姉」",
        "translations": {
            "initial": "「Selamat pagi, Sora-nee」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 51,
        "original": "諳子",
        "translations": {
            "initial": "Sorane",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 52,
        "original": "「おはよう、いっちゃん。い、いつから見てたの？」",
        "translations": {
            "initial": "「Selamat pagi, Icchan. Se-sejak kapan kamu melihatku？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 53,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 54,
        "original": "「『大好きないっちゃんのために、がんばって朝ご飯作らないと！』って言い出したあたりかな？」",
        "translations": {
            "initial": "「Mungkin sejak kamu bilang, 『Aku harus semangat masak sarapan buat Icchan tersayang！』？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 55,
        "original": "嘘だけど。",
        "translations": {
            "initial": "Itu bohong, sih.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 56,
        "original": "諳子",
        "translations": {
            "initial": "Sorane",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 57,
        "original": "「え、そこから見てたの！？」",
        "translations": {
            "initial": "「Eh, kamu melihatnya dari bagian itu！？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 58,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 59,
        "original": "「冗談のつもりだったんだけど……そら姉、そんなこと言ってたのか？」",
        "translations": {
            "initial": "「Tadinya aku cuma bercanda... tapi Sora-nee, apa kamu benar-benar mengatakannya？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 60,
        "original": "諳子",
        "translations": {
            "initial": "Sorane",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 61,
        "original": "「う、うん……」",
        "translations": {
            "initial": "「U-umm... iya...」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 62,
        "original": "そら姉が真っ赤になって、エプロンの裾をもじもじともてあそび始める。",
        "translations": {
            "initial": "Wajah Sora-nee memerah padam, lalu ia mulai memainkan ujung celemeknya dengan malu-malu.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 63,
        "original": "その仕草がかわいくて仕方がなかった俺は、もう我慢ができなかった。",
        "translations": {
            "initial": "Gerak-geriknya itu sangat lucu sampai aku tidak bisa menahannya lagi.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 64,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 65,
        "original": "「そら姉、抱きしめてもいい？」",
        "translations": {
            "initial": "「Sora-nee, boleh aku memelukmu？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 66,
        "original": "諳子",
        "translations": {
            "initial": "Sorane",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 67,
        "original": "「え、でも、エプロンが汚れてるから、いっちゃんも汚れちゃうよ？」",
        "translations": {
            "initial": "「Eh, tapi, celemekku kotor, nanti Icchan juga ikutan kotor lho？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 68,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 69,
        "original": "「気にしない。それとも、そら姉は抱きしめられるの、嫌？」",
        "translations": {
            "initial": "「Gak masalah. Atau, Sora-nee gak suka kalau kupeluk？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 70,
        "original": "諳子",
        "translations": {
            "initial": "Sorane",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 71,
        "original": "「……いや、じゃない」",
        "translations": {
            "initial": "「......Gak, bukannya gak suka」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 72,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 73,
        "original": "「ごめん、よく聞こえなかった。もう一回言ってくれるかな？」",
        "translations": {
            "initial": "「Maaf, barusan kurang kedengaran. Bisa tolong ulangi sekali lagi？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 74,
        "original": "諳子",
        "translations": {
            "initial": "Sorane",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 75,
        "original": "「……もうっ。聞こえたでしょ！その顔を見ればわかるもの」",
        "translations": {
            "initial": "「......Iih. Kamu dengar kan！ Dari wajahmu saja aku sudah tahu」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 76,
        "original": "怒られてしまったけど、今はそんなそら姉も愛おしくてたまらない。",
        "translations": {
            "initial": "Aku malah kena marah, tapi saat ini Sora-nee yang seperti itu pun terasa sangat menggemaskan bagiku.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 77,
        "original": "だって、やっと恋人同士になることができたんだ。",
        "translations": {
            "initial": "Karena akhirnya, kami berdua resmi menjadi sepasang kekasih.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 78,
        "original": "腕を伸ばして、そら姉の体をそっと抱き寄せ――。",
        "translations": {
