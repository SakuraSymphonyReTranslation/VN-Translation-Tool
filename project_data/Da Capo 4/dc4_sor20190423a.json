            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 87,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 88,
        "original": "「あ、ああ、そうだ」",
        "translations": {
            "initial": "「I-iya, benar」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 89,
        "original": "完全に目を覚ました二乃を前にして、俺はそら姉と付き合い始めたことを報告した。",
        "translations": {
            "initial": "Di hadapan Nino yang sudah sepenuhnya terbangun, aku pun melaporkan bahwa aku dan Sora-nee mulai berpacaran.",
