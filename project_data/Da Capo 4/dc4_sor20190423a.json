            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 91,
        "original": "@t20@d1@t21@d2「それにしても……ようやくですか」",
        "translations": {
            "initial": "@t20@d1@t21@d2「Tapi meski begitu...... akhirnya ya」",
