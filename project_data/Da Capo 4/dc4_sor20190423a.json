    },
    {
        "id": 96,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 97,
        "original": "「……ちっとも心がこもってない感じがするんだけど」",
        "translations": {
            "initial": "「......Rasanya kok sama sekali nggak ada tulus-tulusnya ya」",
