    {
        "id": 94,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 95,
        "original": "「さあ？何にしてもめでたいですねー。おめでとうございます」",
        "translations": {
            "initial": "「Entahlah？ Pokoknya selamat ya. Selamat atas hubungan kalian」",
