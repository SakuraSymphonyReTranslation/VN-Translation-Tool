    },
    {
        "id": 92,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 93,
        "original": "「ようやくって何だよ」",
        "translations": {
            "initial": "「Apa maksudmu dengan akhirnya?」",
