    },
    {
        "id": 66,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 67,
        "original": "「人気だから売れ切れが心配とか？」",
