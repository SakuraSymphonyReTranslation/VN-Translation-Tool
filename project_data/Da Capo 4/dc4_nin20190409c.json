            "initial": "「Nggak, volume terbaru Nigekoi sudah terbit tanggal 15 dua bulan lalu」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 70,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 71,
        "original": "「……意外に詳しいな、しかも日付まで」",
        "translations": {
            "initial": "「...Ternyata kamu tahu banyak ya, sampai ke tanggalnya segala」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
