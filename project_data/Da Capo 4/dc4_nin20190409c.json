        "original": "杉並",
        "translations": {
            "initial": "Suginami",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 73,
        "original": "「ふん、世相の流行を押さえておくのは、俺様の務めのひとつだからな」",
