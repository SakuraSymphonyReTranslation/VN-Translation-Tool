            "initial": "「Mungkin takut kehabisan karena populer？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 68,
        "original": "杉並",
        "translations": {
            "initial": "Suginami",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 69,
        "original": "「いや、逃げ恋の新刊は先々月の１５日だ」",
