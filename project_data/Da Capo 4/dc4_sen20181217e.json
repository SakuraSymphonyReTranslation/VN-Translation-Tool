[
    {
        "id": 0,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 1,
        "original": "「えー……面倒じゃないですか……」",
        "translations": {
            "initial": "「Eeeh...... Males banget tau......」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 2,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 3,
        "original": "「まあ、そう言うなって……。もとはと言えばお前の話なわけだし」",
        "translations": {
            "initial": "「Yah, jangan gitu dong....... Lagian kan awalnya ini masalah tentang kamu juga」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 4,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 5,
        "original": "「@t25@d1@t61@d2私の話じゃなくて、誰だかわからない男子たちの話でしょう……。恋愛相談を請け負っているのは白河さんの自由ですが……」",
        "translations": {
            "initial": "「@t25@d1@t61@d2Bukan masalahku, tapi masalah cowok-cowok yang nggak jelas itu, kan....... Memang haknya Shirakawa-san sih kalau mau nerima konsultasi cinta, tapi......」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 6,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 7,
        "original": "「そう言われてみると、確かにそうだな……」",
        "translations": {
            "initial": "「Kalau dipikir-pikir, bener juga sih......」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 8,
        "original": "二乃のいうことはもっともだ。",
        "translations": {
            "initial": "Apa yang dikatakan Nino memang ada benarnya.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 9,
        "original": "白河が好きでやってる恋愛相談に、男子が相談にきただけで、二乃は今は閉店中……と。",
        "translations": {
            "initial": "Shirakawa memang suka memberikan konsultasi cinta, dan ada cowok yang datang untuk berkonsultasi, sementara Nino saat ini sedang 'tutup toko'...... Begitulah.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 10,
        "original": "うーむ、これは困ったぞ。",
        "translations": {
            "initial": "Hmm, ini gawat juga.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 11,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 12,
        "original": "「@b1@t27@w1……はぁ。仕方無いですね。判りました」",
        "translations": {
            "initial": "「@b1@t27@w1......Haaah. Ya sudahlah, mau gimana lagi. Aku mengerti」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 13,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 14,
        "original": "「え……？」",
        "translations": {
            "initial": "「Eh......？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 15,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 16,
        "original": "「@t44@d1私に関することは私がお断りするようにします。それに、他人の恋愛相談に関して白河さんをお手伝いできることがあったら、それもしますね」",
        "translations": {
            "initial": "「@t44@d1Hal-hal yang berkaitan denganku, biarkan aku sendiri yang menolaknya. Selain itu, kalau ada yang bisa kubantu soal konsultasi cinta orang lain untuk Shirakawa-san, aku juga bakal bantu kok」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 17,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 18,
        "original": "「自分以外のやつもか？」",
        "translations": {
            "initial": "「Masalah orang lain juga？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 19,
        "original": "どういう風の吹き回しだ？",
        "translations": {
            "initial": "Ada angin apa nih tiba-tiba？",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 20,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 21,
        "original": "「@t58@d1というか、自分と関係無いことだったらむしろ面白そうじゃないですか。みんなの恋愛事情」",
        "translations": {
            "initial": "「@t58@d1Maksudku, kalau nggak ada hubungannya sama aku, kayaknya bakal seru kan? Ngelihat urusan asmara orang-orang」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 22,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 23,
        "original": "「あ、だから白河さんはあの活動してるのかな？」",
        "translations": {
            "initial": "「Ah, apa mungkin itu alasan Shirakawa-san ngelakuin kegiatan itu ya？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 24,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 25,
        "original": "「そういう感じはしないけどな……。それにしても、他人のことなら楽しめるのか」",
        "translations": {
            "initial": "「Kayaknya nggak gitu sih....... Tapi, ternyata kamu bisa menikmati urusan orang lain ya」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 26,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 27,
        "original": "「@t16@d1@t59@d2そりゃあそうです。他人の恋愛事情なんてエンターテイメントじゃないですか、うふふ」",
        "translations": {
            "initial": "「@t16@d1@t59@d2Tentu saja. Urusan cinta orang lain itu kan hiburan, ufufu」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 28,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 29,
        "original": "「目をキラキラさせるんじゃない。まあ、俺もそこは否定はしないけどな。自分の方も良いのか？」",
        "translations": {
            "initial": "「Jangan sampai matamu berbinar-binar gitu dong. Yah, aku juga nggak membantah itu sih. Tapi buat urusanmu sendiri nggak apa-apa？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 30,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 31,
        "original": "「@t63@bt1兄さんにさっきみたいな困った顔をずっとされても、私まで困ってしまいますから。あんまり安請け合いしないように気をつけて下さいよ？」",
        "translations": {
            "initial": "「@t63@bt1Kalau Nii-san terus-terusan pasang wajah bingung kayak tadi, aku juga jadi ikut bingung tau. Makanya, jangan gampang mengiyakan permintaan orang ya？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 32,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 33,
        "original": "「おう、気をつける」",
        "translations": {
            "initial": "「Sip, aku bakal hati-hati」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 34,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 35,
        "original": "「@by1@t14@d1@t53@d2もう……今のだってなんだか安請け合いっぽいですよ。……ふふふ、それが兄さんといえば兄さんですけど」",
        "translations": {
            "initial": "「@by1@t14@d1@t53@d2Duh... barusan itu kedengarannya kayak janji asal-asalan lagi. ...Hehehe, tapi ya itu baru namanya Nii-san sih」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 36,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 37,
        "original": "「な、なんだよ……なんかバカにされてる感じがするぞ」",
        "translations": {
            "initial": "「A-apaan tuh... kok aku ngerasa kayak lagi diremehin ya」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 38,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 39,
        "original": "「@t36@d1していません。褒めてもいませんけど。兄さんは兄さんだなって話です」",
        "translations": {
            "initial": "「@t36@d1Enggak kok. Tapi gak lagi muji juga. Intinya Nii-san ya tetap Nii-san」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 40,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 41,
        "original": "「お、おう……」",
        "translations": {
            "initial": "「O-oh, gitu ya...」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 42,
        "original": "どっちにしても、二乃が納得してくれて助かった。",
        "translations": {
            "initial": "Apa pun itu, syukurlah kalau Nino akhirnya mau mengerti.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 43,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 44,
        "original": "「兄さんにちゃんと判って欲しいのは――」",
        "translations": {
            "initial": "「Yang aku mau Nii-san benar-benar paham itu adalah-」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 45,
        "original": "おっと、簡単に終わる話じゃなかったか。",
        "translations": {
            "initial": "Waduh, sepertinya urusannya gak bakal selesai secepat itu.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 46,
        "original": "甘かったか？",
        "translations": {
            "initial": "Apa aku terlalu menggampangkannya？",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 47,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 48,
        "original": "「@t35@d1@t73@d2兄さんのために協力する、っていうことです。白河さんや鷺澤さんのためじゃないですからね？当然、謎の男子たちも関係ありません」",
        "translations": {
            "initial": "「@t35@d1@t73@d2Aku bantu ini itu demi Nii-san. Bukan demi Shirakawa-san atau Sagisawa-san, lho ya？ Tentu saja, para cowok misterius itu juga gak ada hubungannya」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 49,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 50,
        "original": "「@t34@d1そこのところは判って下さいよね……。それから一つ条件があります」",
        "translations": {
            "initial": "「@t34@d1Tolong pahami bagian itu, ya.... Terus, aku punya satu syarat」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 51,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 52,
        "original": "「条件……？どんなだ？最大限の努力はするが」",
        "translations": {
            "initial": "「Syarat...？ Apaan tuh？ Aku bakal usaha semaksimal mungkin, sih」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 53,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 54,
        "original": "「デートして下さい」",
        "translations": {
            "initial": "「Ayo kencan denganku」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 55,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 56,
        "original": "「デート？どっかいきたいところでもあるのか？」",
        "translations": {
            "initial": "「Kencan？ Ada tempat yang pengen kamu datangi？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 57,
        "original": "思ったより簡単そうな条件だ。",
        "translations": {
            "initial": "Ternyata syaratnya lebih gampang dari yang kubayangkan.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 58,
        "original": "デートというと大仰な感じもするけど、二乃やそら姉とはデートと称して出掛けることは少なく無い。",
        "translations": {
            "initial": "Meski istilah kencan terdengar agak berlebihan, tapi aku memang lumayan sering pergi jalan-jalan bareng Nino atau Sora-nee dengan embel-embel kencan.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 59,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 60,
        "original": "「@t23@d1行きたいところがあるんです。というか、協力の話と直接関係していると言っても過言ではありません」",
        "translations": {
            "initial": "「@t23@d1Ada tempat yang ingin kudatangi. Malah, gak berlebihan kalau dibilang ini ada hubungannya langsung dengan bantuan yang aku kasih」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 61,
        "original": "二乃が悪戯な笑みを浮かべる。",
        "translations": {
            "initial": "Nino menyunggingkan senyum nakal.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 62,
        "original": "協力の話とも関係……？",
        "translations": {
            "initial": "Ada hubungannya dengan bantuan itu...？",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 63,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 64,
        "original": "「どういうことかな……？」",
        "translations": {
            "initial": "「Maksudnya gimana......？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 65,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 66,
        "original": "「@t12@bt1クリスマス、ワンダーランドにいきましょう」",
        "translations": {
            "initial": "「@t12@bt1Ayo kita pergi ke Wonderland pas natal」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 67,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 68,
        "original": "「え？クリスマス……に、ワンダーランド……？」",
        "translations": {
            "initial": "「Eh？ Pas natal...... ke Wonderland......？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 69,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 70,
        "original": "「@bt1@t24@d1@t87@d2はい。言葉通りです。どうしてもキャンセル分や当日販売のチケットが取れなかったら、それは仕方無いのでその時は『月見団子』で水鏡餅をご馳走して下さい」",
        "translations": {
            "initial": "「@bt1@t24@d1@t87@d2Iya. Seperti yang aku katakan. Kalau memang nggak bisa dapat tiket pembatalan atau tiket OTS, ya apa boleh buat, saat itu traktir aku Mikagamimochi di 'Tsukimi Dango' saja」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 71,
        "original": "二乃",
        "translations": {
            "initial": "Nino",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 72,
        "original": "「どうですか？ダメ……ですか？」",
        "translations": {
            "initial": "「Gimana？ Nggak...... boleh ya？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 73,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
