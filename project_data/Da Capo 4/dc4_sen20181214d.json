            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 68,
        "original": "「いいえ、別に何も？」",
        "translations": {
            "initial": "「Enggak, nggak ada apa-apa kok？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
