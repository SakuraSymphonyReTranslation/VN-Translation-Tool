    {
        "id": 19,
        "original": "「へーい」",
        "translations": {
            "initial": "「Iya, iya」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 20,
        "original": "そら姉を敵に回して一対二は不利なので、この戦場からはとっとと退却だ。",
        "translations": {
            "initial": "Melawan Sora-nee dalam situasi satu lawan dua itu merugikan, jadi lebih baik aku segera mundur dari medan perang ini.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
