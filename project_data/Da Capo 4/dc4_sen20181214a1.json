[
    {
        "id": 0,
        "original": "途切れていた記憶。",
        "translations": {
            "initial": "Ingatan yang sempat terputus.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 1,
        "original": "その連続性の復活を自覚した。",
        "translations": {
            "initial": "Aku menyadari kembalinya kesinambungan itu.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 2,
        "original": "こういうのは、その大半が目が覚めたというケースだ。",
        "translations": {
            "initial": "Biasanya, hal seperti ini terjadi saat seseorang terbangun.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 3,
        "original": "でも今は多分違う。",
        "translations": {
            "initial": "Tapi sepertinya sekarang berbeda.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 4,
        "original": "もう一つのケース――夢を見ている、というやつ。",
        "translations": {
            "initial": "Ini adalah kasus lainnya-yaitu saat sedang bermimpi.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 5,
        "original": "フワッとした感覚。",
        "translations": {
            "initial": "Sensasi yang melayang.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 6,
        "original": "ボンヤリした視界。",
        "translations": {
            "initial": "Pandangan yang kabur.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 7,
        "original": "そういったもののせいで、希に夢を見ている最中にそれが夢だと判ることがある。",
        "translations": {
            "initial": "Gara-gara hal semacam itu, terkadang aku menyadari bahwa ini adalah mimpi saat sedang memimpikannya. (lucid dream)",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 8,
        "original": "映像が勝手に水鏡湖へと変わった。",
        "translations": {
            "initial": "Pemandangan pun berubah dengan sendirinya menjadi Danau Mikagami.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 9,
        "original": "途端に周囲を包み込む甘い香り。",
        "translations": {
            "initial": "Seketika itu juga, aroma manis menyelimuti sekelilingku.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 10,
        "original": "鮮やかに舞い狂う花びら。",
        "translations": {
            "initial": "Kelopak bunga yang menari-nari dengan indahnya.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 11,
        "original": "いつの頃からだろう。",
        "translations": {
            "initial": "Sejak kapan ya?",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 12,
        "original": "子どもの頃のある時から、俺は客観的に夢を見ることが増えた。",
        "translations": {
            "initial": "Sejak suatu waktu di masa kecil, aku jadi lebih sering melihat mimpi secara objektif.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 13,
        "original": "もちろん全てじゃない。",
        "translations": {
            "initial": "Tentu saja tidak semuanya.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 14,
        "original": "目が覚めてから、ああ今のは夢だったのか――と気付くことの方が多い。",
        "translations": {
            "initial": "Lebih sering aku baru menyadarinya setelah bangun, 'Ah, ternyata tadi itu cuma mimpi'.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 15,
        "original": "けれど、今見ているような、まるで自分の見ている夢ではないような夢。",
        "translations": {
            "initial": "Namun, mimpi yang sedang kulihat sekarang terasa seperti bukan mimpi yang kubuat sendiri.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 16,
        "original": "そういった夢を、多分１０年くらい前からだろうか、見るようになった。",
        "translations": {
            "initial": "Mimpi semacam ini mulai kualami mungkin sejak sepuluh tahun yang lalu.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 17,
        "original": "不思議な感覚だ。",
        "translations": {
            "initial": "Rasanya sungguh aneh.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 18,
        "original": "自らの夢であるような、誰かの夢であるような。",
        "translations": {
            "initial": "Seolah-olah ini mimpiku, tapi sekaligus mimpi milik orang lain.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 19,
        "original": "こういった夢はＶＲゲームにも似ている。",
        "translations": {
            "initial": "Mimpi seperti ini mirip dengan permainan VR.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 20,
        "original": "視界を移動させれば映像はそれに追従する。",
        "translations": {
            "initial": "Jika aku mengalihkan pandangan, visualnya pun akan mengikuti.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 21,
        "original": "だから、一見すると自分が主体の夢のように感じる。",
        "translations": {
            "initial": "Karena itulah, sekilas aku merasa akulah subjek utama dalam mimpi ini.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 22,
        "original": "一方で、夢の大筋は自らの意志など無関係に場面転換を続けていく。",
        "translations": {
            "initial": "Di sisi lain, alur besar mimpi ini terus berganti adegan tanpa memedulikan kehendakku.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 23,
        "original": "本当に自分が見ている夢というのは、そういった大枠でも違和感を覚えない。",
        "translations": {
            "initial": "Mimpi yang benar-benar berasal dari diri sendiri tidak akan memberikan rasa janggal meski dalam kerangka besar sekalipun.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 24,
        "original": "仮に乗っていた電車がトンネルを抜けた先で大空を飛行していても、そこに違和感はない。",
        "translations": {
            "initial": "Seandainya kereta yang kunaiki menembus terowongan lalu tiba-tiba terbang di angkasa pun, tidak akan ada rasa aneh.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 25,
        "original": "それが自分自身の夢だ。",
        "translations": {
            "initial": "Itulah yang namanya mimpi sendiri.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 26,
        "original": "けれどＶＲ感覚の夢ってやつは、ドアを開けて部屋から出て、そこが知っている廊下だったとしても、違和感を覚えてしまう。",
        "translations": {
            "initial": "Namun dalam mimpi dengan sensasi VR ini, meski aku membuka pintu dan keluar menuju lorong yang kukenal, aku tetap saja merasa ada yang janggal.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 27,
        "original": "トンネルの先が大空な夢よりも、よほど論理的だったり筋が通っていたりするのに。",
        "translations": {
            "initial": "Padahal itu jauh lebih logis dan masuk akal daripada mimpi di mana ujung terowongan adalah langit terbuka.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 28,
        "original": "俺の意志と違うところで進んでいく。",
        "translations": {
            "initial": "Semuanya berjalan di luar kehendakku.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 29,
        "original": "そんな感覚なのだ。",
        "translations": {
            "initial": "Begitulah rasanya.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 30,
        "original": "そして、これはそんな夢に違い無いと俺の直感は告げていた。",
        "translations": {
            "initial": "Dan intuisiku mengatakan kalau ini pasti mimpi semacam itu.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 31,
        "original": "夢の中でも水鏡湖は本当に美しい。",
        "translations": {
            "initial": "Bahkan di dalam mimpi pun, Danau Mikagami benar-benar indah.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 32,
        "original": "巨大な桜の木は夢の中なら冬でも満開だ。",
        "translations": {
            "initial": "Pohon sakura raksasa itu mekar sepenuhnya di dalam mimpi, meski sekarang sedang musim dingin.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 33,
        "original": "そう、こんな風に。",
        "translations": {
            "initial": "Ya, seperti ini.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 34,
        "original": "…………。",
        "translations": {
            "initial": "............。",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 35,
        "original": "それにしてもため息の出る美しさだ。",
        "translations": {
            "initial": "Benar-benar keindahan yang membuatku takjub.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 36,
        "original": "人間の刻む時より遥かに長い寿命を持つ大樹を前に、しかしあのジジイは言った。",
        "translations": {
            "initial": "Di hadapan pohon raksasa yang usianya jauh melampaui waktu manusia, si kakek tua itu berkata.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 37,
        "original": "元",
        "translations": {
            "initial": "Gen",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 38,
        "original": "「大樹の齢は人のそれを遥かに超える。この星で最も長く生きるのも植物たちだ。だが、それとて星の齢に比べればほんの刹那のことのようなもんだ」",
        "translations": {
            "initial": "「Usia pohon besar jauh melampaui manusia. Tumbuhan adalah makhluk yang hidup paling lama di planet ini. Tapi, itu pun hanya terasa seperti sekejap mata jika dibandingkan dengan usia planet ini」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 39,
        "original": "元",
        "translations": {
            "initial": "Gen",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 40,
        "original": "「星の運行は、この宇宙におけるモノのスケールのひとつの基準といえるな」",
        "translations": {
            "initial": "「Pergerakan planet bisa dibilang merupakan salah satu standar skala benda-benda di alam semesta ini」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 41,
        "original": "元",
        "translations": {
            "initial": "Gen",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 42,
        "original": "「だがな、そこで思考を止めてはならん。宇宙が最大の単位というわけでもない。その先にはまだ人類が解明しておらん尺度というものが広がっていると考えるべきだ」",
        "translations": {
            "initial": "「Tapi, jangan berhenti berpikir sampai di situ. Alam semesta bukanlah unit terbesar. Kamu harus berpikir bahwa di baliknya masih terbentang skala yang belum terpecahkan oleh umat manusia」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 43,
        "original": "元",
        "translations": {
            "initial": "Gen",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 44,
        "original": "「良いか、一登。この桜の木も、この星も、そして宇宙も、我々人間からしたら途方もないスケールを持っているように感じられる。しかし、人間もまた負けてはおらん」",
        "translations": {
            "initial": "「Dengar, Ichito. Pohon sakura ini, planet ini, bahkan alam semesta, terasa memiliki skala yang luar biasa bagi kita manusia. Namun, manusia juga tidak kalah」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 45,
        "original": "元",
        "translations": {
            "initial": "Gen",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 46,
        "original": "「お前にも、宇宙に匹敵する、いや、凌駕すらするものがちゃんとあるんだ。わかるか？」",
        "translations": {
            "initial": "「Di dalam dirimu pun, ada sesuatu yang setara dengan alam semesta, bahkan melampauinya. Kamu mengerti？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 47,
        "original": "元",
        "translations": {
            "initial": "Gen",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 48,
        "original": "「ふふ、まだ判るまいな」",
        "translations": {
            "initial": "「Hehe, sepertinya kamu belum paham ya」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 49,
        "original": "元",
        "translations": {
            "initial": "Gen",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 50,
        "original": "「それはな、お前の心だ。俺の心もそうだ。人の心は無限の広がりを持てる。小さい心で終わるヤツもいれば、とんでもなくデカイ心を持ってるやつもいる」",
        "translations": {
            "initial": "「Itu adalah hatimu. Begitu juga dengan hatiku. Hati manusia bisa memiliki luas yang tak terbatas. Ada orang yang berakhir dengan hati yang sempit, tapi ada juga yang punya hati yang luar biasa luas」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 51,
        "original": "元",
        "translations": {
            "initial": "Gen",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 52,
        "original": "「宇宙を超えるスケールを、俺たちは心の中に持つことができる。お前はそのことをしっかり覚えておけ」",
        "translations": {
            "initial": "「Kita bisa memiliki skala yang melampaui alam semesta di dalam hati kita. Kamu harus ingat baik-baik hal itu」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 53,
        "original": "元",
        "translations": {
            "initial": "Gen",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 54,
        "original": "「常坂は、まずそれを知らねばならん。良いな？」",
        "translations": {
            "initial": "「Tokisaka, kamu harus memahami hal itu terlebih dahulu. Mengerti？」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 55,
        "original": "…………。",
        "translations": {
            "initial": "............。",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 56,
        "original": "なーんて言ってたけどさ。",
        "translations": {
            "initial": "Begitulah yang dia katakan, tapi...",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 57,
        "original": "この馬鹿でかい、樹齢千年とも言われる桜を前にして俺はそれ以上のスケールを持てるのか？",
        "translations": {
            "initial": "Menghadapi pohon sakura raksasa yang konon berusia seribu tahun ini, apa aku bisa memiliki skala yang lebih besar dari itu？",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 58,
        "original": "全く自信がないぜ。",
        "translations": {
            "initial": "Aku sama sekali tidak percaya diri.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 59,
        "original": "まして、視界に収めることさえ不可能な、この足の下。",
        "translations": {
            "initial": "Apalagi, apa yang ada di bawah kakiku ini bahkan tidak mungkin bisa ditangkap seluruhnya oleh pandangan.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 60,
        "original": "地球。",
        "translations": {
            "initial": "Bumi.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 61,
        "original": "そして彼方の星々。",
        "translations": {
            "initial": "Dan bintang-bintang di kejauhan.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 62,
        "original": "ジジイのスケールがデカすぎるだけじゃねえの？",
        "translations": {
            "initial": "Apa bukan kakek tua itu saja yang skalanya terlalu kebesaran？",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 63,
        "original": "俺はこの巨木から降り注ぐ無数の花びらの中で、",
        "translations": {
            "initial": "Di tengah guguran kelopak bunga yang tak terhitung jumlahnya dari pohon raksasa ini,",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 64,
        "original": "淡いピンク色と甘い桜の香りにつつまれているだけで、",
        "translations": {
            "initial": "hanya dengan diselimuti warna merah muda pucat dan aroma sakura yang manis,",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 65,
        "original": "己の小ささを感じている方が、どちらかと言えば落ち着くんだ。",
        "translations": {
            "initial": "aku merasa lebih tenang ketika menyadari betapa kecilnya diriku.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 66,
        "original": "一陣の風が吹いた。",
        "translations": {
            "initial": "Semburan angin bertiup.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 67,
        "original": "舞い狂い、視界を遮っていた花びらたち。",
        "translations": {
            "initial": "Kelopak-kelopak bunga yang menari liar sempat menghalangi pandangan.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 68,
        "original": "それらが一掃されると、大樹の袂に人影。",
        "translations": {
            "initial": "Saat semuanya tersapu bersih, terlihat sesosok bayangan di bawah pohon besar itu.",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 69,
