            "better": "",
            "best": "",
            "polished": ""
        },
        "reading": "かずと"
    },
    {
        "id": 32,
        "original": "「ワンダーランドって、プレオープンのことか？」",
        "translations": {
            "initial": "「Wonderland? Maksudmu tentang pre-opening-nya?」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
