        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        },
        "reading": "かずと"
    },
    {
        "id": 40,
        "original": "「そういうお前は行ったのか？」",
        "translations": {
            "initial": "「Kalau kamu sendiri, apa kamu pergi？」",
            "machine": "",
            "better": "",
            "best": "",
