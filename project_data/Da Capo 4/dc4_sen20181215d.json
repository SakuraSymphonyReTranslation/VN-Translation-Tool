        },
        "reading": "すぎなみ"
    },
    {
        "id": 42,
        "original": "「うむ、行ってきた」",
        "translations": {
            "initial": "「Umu, aku sudah ke sana」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        },
        "reading": "「うむ、いくてくるた」"
    },
