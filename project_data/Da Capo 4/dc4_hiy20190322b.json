    },
    {
        "id": 91,
        "original": "ひより",
        "translations": {
            "initial": "Hiyori",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 92,
        "original": "「あ、一応ここはお店なので、誰かに聞かれても大丈夫な方の趣味でお願いします！」",
        "translations": {
            "initial": "「Ah, karena kita lagi di toko, tolong sebutkan hobi yang aman didengar orang lain ya！」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 93,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 94,
        "original": "「人に言えないような趣味は持ってねぇよ！」",
        "translations": {
            "initial": "「Aku gak punya hobi yang aneh-aneh sampai gak bisa dibilang ke orang lain kok！」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
