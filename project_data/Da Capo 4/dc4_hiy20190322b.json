            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 100,
        "original": "一登",
        "translations": {
            "initial": "Ichito",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
    {
        "id": 101,
        "original": "「そうそう。あまり派手さはないんだけど、癒やされるっていうか落ち着くっていうかさ」",
        "translations": {
            "initial": "「Iya, benar. Memang gak terlalu mencolok sih, tapi auranya menenangkan dan bikin hati adem gitu」",
            "machine": "",
            "better": "",
            "best": "",
            "polished": ""
        }
    },
